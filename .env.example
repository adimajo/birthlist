# Copy to .env (never commit it) and adjust. All values are optional unless marked REQUIRED.

# --- Django ---
# REQUIRED in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=
DEBUG=false
# Public URL of the site, without trailing slash (used in e-mail links, CSRF and secure cookies)
SITE_URL=https://birthlist.example.org
# Comma separated host names the site answers to
ALLOWED_HOSTS=birthlist.example.org
# Extra trusted origins (defaults to SITE_URL when it is https)
#CSRF_TRUSTED_ORIGINS=
# Where the SQLite file lives (the container uses /data/db.sqlite3)
#DB_PATH=/data/db.sqlite3
# Directory with the private overlay: templates/ and static/ that override the defaults
#SITE_CONTENT_DIR=/content
#LOG_LEVEL=INFO

# --- Access ---
# Shared phrase guests must type to create an account; registration is disabled when empty
REGISTRATION_CODE=

# --- Site identity ---
SITE_TITLE=Liste de naissance
COUPLE_NAMES=Alex et Sam
BABY_NAME=Bébé
# Optional link to a money pot and postal address (lines separated by |)
GIFT_POT_URL=
POSTAL_ADDRESS=
# Hero image at the top of the web page, e.g. bigday/images/hero.jpg (empty = none)
HEADER_IMAGE=
# Image embedded in e-mails, path relative to a static directory, e.g. bigday/images/hero.jpg (empty = none)
EMAIL_HERO_IMAGE=
#ANNOUNCEMENT_SUBJECT=
#NOTICE_SUBJECT=

# --- E-mail (SMTP) ---
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# From header, e.g. "Alex & Sam <alex@example.org>"
DEFAULT_FROM_EMAIL=
REPLY_TO_EMAIL=
# Comma separated addresses put in copy of every campaign e-mail
CC_LIST=
